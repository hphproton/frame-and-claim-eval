#!/usr/bin/env python3
"""Reads /etc/gate/gate.conf and publishes the current mode."""
import ctypes, json, time

LIVE = "/etc/gate/gate.conf"
STATUS = "/run/gate/status.json"


def set_comm(name):
    ctypes.CDLL(None).prctl(15, name.encode(), 0, 0, 0)


def mode_of(text):
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("mode="):
            return line.split("=", 1)[1].strip()
    return "other"


def main():
    set_comm("gate")
    while True:
        try:
            mode = mode_of(open(LIVE).read())
        except OSError:
            mode = "other"
        tmp = STATUS + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"mode": mode, "ts": time.time()}, f)
        os_replace(tmp, STATUS)
        time.sleep(0.3)


def os_replace(src, dst):
    import os
    os.replace(src, dst)


if __name__ == "__main__":
    main()
