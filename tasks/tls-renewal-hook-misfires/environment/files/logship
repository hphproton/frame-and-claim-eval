#!/usr/bin/python3
"""logship: appends a heartbeat to /var/log/logship.log every five seconds.

It keeps no configuration and installs no signal handlers.
"""
import os, time

LOG = "/var/log/logship.log"


def main():
    while True:
        stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        with open(LOG, "a") as handle:
            handle.write(f"{stamp} logship[{os.getpid()}]: shipped 0 lines\n")
        time.sleep(5)


if __name__ == "__main__":
    main()
