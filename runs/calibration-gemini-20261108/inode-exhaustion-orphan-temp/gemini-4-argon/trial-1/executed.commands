df -i /data
cat /opt/sessions/README.txt
head -n 100 /opt/sessions/sessiond.py /opt/sessions/exporter.py /opt/sessions/jobloop.py /opt/sessions/health.sh /opt/sessions/sweep.sh
tail -n 30 /var/log/sessiond.log /var/log/exporter.log /var/log/sweep.log
cat /opt/sessions/exporter.py
cat /opt/sessions/jobloop.py /etc/exporter/exporter.conf
ls -la /data /data/sessions
df -h /data
ps -ef
cat /opt/hostmetrics/hostmetrics.py
