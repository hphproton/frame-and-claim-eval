df -i /data
cat /opt/sessions/README.txt /opt/sessions/sweep.sh /opt/sessions/health.sh
cat /opt/sessions/exporter.py /opt/sessions/sessiond.py /opt/sessions/jobloop.py
tail -n 20 /var/log/sessiond.log /var/log/exporter.log /var/log/sweep.log /run/jobloop/last.json
df -h /data
cat /etc/exporter/exporter.conf
cat /opt/sessions/sessiond.py
find /data -maxdepth 2 -ls
