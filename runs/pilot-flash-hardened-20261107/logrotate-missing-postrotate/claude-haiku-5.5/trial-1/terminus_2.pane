Filesystem      Size  Used Avail Use% Mounted on
tmpfs            48M   12K   48M   1% /var/log
/var/log/reporter/current.log {
    rotate 1
    missingok
    notifempty
    postrotate
        pkill -HUP -x reporter || true
    endscript
}
